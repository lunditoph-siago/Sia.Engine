<Project>
  <PropertyGroup>
    <_BistroAssetHash>9B3959E5F0CA96843305EAA053DB5FAF5A0661F129F4F6E197C130107994C7A9</_BistroAssetHash>
    <_BistroFinestAssetHash>AAEE2B33846383A89B2EC08C390AE4BBCDD17A59BECBCB3E4FF3E2867AE472CC</_BistroFinestAssetHash>
    <_BistroLicenseHash>9A9EF3C33320EEBE6126B0C7DC327885806BDE242283BBE6E4AE77641AD703E4</_BistroLicenseHash>
    <_BistroReleaseUrl>https://github.com/lunditoph-siago/Sia.Engine/releases/download/Bistro</_BistroReleaseUrl>
    <BistroAssetPath Condition="'$(BistroAssetPath)' == ''">$([System.IO.Path]::GetFullPath('$(BaseIntermediateOutputPath)bistro/$(_BistroAssetHash)/Bistro.siapbr', '$(MSBuildProjectDirectory)'))</BistroAssetPath>
    <BistroFinestAssetPath Condition="'$(BistroFinestAssetPath)' == ''">$([System.IO.Path]::GetFullPath('$(BaseIntermediateOutputPath)bistro/$(_BistroFinestAssetHash)/BistroFinest.siapbr', '$(MSBuildProjectDirectory)'))</BistroFinestAssetPath>
    <_BistroLicensePath>$([System.IO.Path]::GetFullPath('$(BaseIntermediateOutputPath)bistro/$(_BistroLicenseHash)/Bistro.LICENSE.txt', '$(MSBuildProjectDirectory)'))</_BistroLicensePath>
  </PropertyGroup>

  <Target Name="PublishBistroAsset" AfterTargets="Publish">
    <DownloadFile Condition="!Exists('$(_BistroLicensePath)')"
                  SourceUrl="$(_BistroReleaseUrl)/LICENSE.txt"
                  DestinationFolder="$([System.IO.Path]::GetDirectoryName('$(_BistroLicensePath)'))"
                  DestinationFileName="Bistro.LICENSE.txt" Retries="3" RetryDelayMilliseconds="1000" />
    <VerifyFileHash File="$(_BistroLicensePath)" Algorithm="SHA256"
                    Hash="$(_BistroLicenseHash)" />
    <DownloadFile Condition="!Exists('$(BistroAssetPath)')"
                  SourceUrl="$(_BistroReleaseUrl)/Bistro.siapbr"
                  DestinationFolder="$([System.IO.Path]::GetDirectoryName('$(BistroAssetPath)'))"
                  DestinationFileName="$([System.IO.Path]::GetFileName('$(BistroAssetPath)'))"
                  Retries="3" RetryDelayMilliseconds="1000" />
    <VerifyFileHash File="$(BistroAssetPath)" Algorithm="SHA256"
                    Hash="$(_BistroAssetHash)" />
    <DownloadFile Condition="!Exists('$(BistroFinestAssetPath)')"
                  SourceUrl="$(_BistroReleaseUrl)/BistroFinest.siapbr"
                  DestinationFolder="$([System.IO.Path]::GetDirectoryName('$(BistroFinestAssetPath)'))"
                  DestinationFileName="$([System.IO.Path]::GetFileName('$(BistroFinestAssetPath)'))"
                  Retries="3" RetryDelayMilliseconds="1000" />
    <VerifyFileHash File="$(BistroFinestAssetPath)" Algorithm="SHA256"
                    Hash="$(_BistroFinestAssetHash)" />
    <PropertyGroup>
      <_BistroPublishPath>$([System.IO.Path]::Combine('$(PublishDir)', 'Assets', 'Bistro.siapbr'))</_BistroPublishPath>
      <_BistroPublishPath Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">$([System.IO.Path]::Combine('$(PublishDir)', 'wwwroot', 'Assets', 'Bistro.siapbr'))</_BistroPublishPath>
    </PropertyGroup>
    <Delete Files="$([System.IO.Path]::GetDirectoryName('$(_BistroPublishPath)'))/Sponza.siapbr;$([System.IO.Path]::GetDirectoryName('$(_BistroPublishPath)'))/SponzaFinest.siapbr;$([System.IO.Path]::GetDirectoryName('$(_BistroPublishPath)'))/Sponza.LICENSE.txt" />
    <Copy SourceFiles="$(BistroAssetPath)" DestinationFiles="$(_BistroPublishPath)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(BistroFinestAssetPath)" DestinationFiles="$([System.IO.Path]::GetDirectoryName('$(_BistroPublishPath)'))/BistroFinest.siapbr" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(_BistroLicensePath)" DestinationFiles="$([System.IO.Path]::GetDirectoryName('$(_BistroPublishPath)'))/Bistro.LICENSE.txt" SkipUnchangedFiles="true" />
    <WriteLinesToFile File="$([System.IO.Path]::GetDirectoryName('$(_BistroPublishPath)'))/Bistro.assets.json"
                      Lines="{&quot;Bistro.siapbr&quot;:&quot;$(_BistroAssetHash)&quot;,&quot;BistroFinest.siapbr&quot;:&quot;$(_BistroFinestAssetHash)&quot;}"
                      Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
  </Target>
</Project>
