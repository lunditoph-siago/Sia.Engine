<Project>
  <PropertyGroup>
    <_ExamplePathPrefix Condition="'$(OS)' == 'Windows_NT'">\\?\</_ExamplePathPrefix>
    <_ExampleContentRoot Condition="'$(ExampleContentDirectory)' != ''">$(_ExamplePathPrefix)$([System.IO.Path]::GetFullPath('$(ExampleContentDirectory)', '$(MSBuildProjectDirectory)'))</_ExampleContentRoot>
    <_ExampleContentCatalog Condition="'$(ExampleContentDirectory)' != ''">$([System.IO.Path]::Combine('$(_ExampleContentRoot)', 'default-scenes.json'))</_ExampleContentCatalog>
    <_ExampleContentPayloads Condition="'$(ExampleContentDirectory)' != ''">$([System.IO.Path]::Combine('$(_ExampleContentRoot)', 'Content'))</_ExampleContentPayloads>
  </PropertyGroup>
  <Target Name="CopyExampleContentToOutput" AfterTargets="Build" Condition="'$(ExampleContentDirectory)' != ''">
    <Error Condition="!Exists('$(_ExampleContentCatalog)')" Text="Example content catalog is missing." />
    <PropertyGroup>
      <_ExampleOutputContentRoot>$(_ExamplePathPrefix)$([System.IO.Path]::GetFullPath('$(OutDir)Assets/Content/', '$(MSBuildProjectDirectory)'))</_ExampleOutputContentRoot>
    </PropertyGroup>
    <ItemGroup>
      <_ExampleOutputContent Include="$([System.IO.Directory]::GetFiles('$(_ExampleContentPayloads)', '*.siaasset', System.IO.SearchOption.AllDirectories))" Condition="Exists('$(_ExampleContentPayloads)')" />
      <_ExampleOutputContent Include="$([System.IO.Directory]::GetFiles('$(_ExampleContentPayloads)', '*.siascene', System.IO.SearchOption.AllDirectories))" Condition="Exists('$(_ExampleContentPayloads)')" />
      <_ExampleOutputContent>
        <RelativeContent>$([System.IO.Path]::GetRelativePath('$(_ExampleContentPayloads)', '%(_ExampleOutputContent.Identity)'))</RelativeContent>
      </_ExampleOutputContent>
      <_ExampleOutputNotices Include="$([System.IO.Directory]::GetFiles('$(_ExampleContentRoot)', '*LICENSE.txt'))" />
    </ItemGroup>
    <Copy SourceFiles="@(_ExampleOutputContent)"
          DestinationFiles="@(_ExampleOutputContent->'$(_ExampleOutputContentRoot)%(RelativeContent)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(_ExampleContentCatalog)" DestinationFolder="$(OutDir)Assets" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_ExampleOutputNotices)" DestinationFolder="$(OutDir)Assets" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishExampleContent" AfterTargets="Publish" Condition="'$(ExampleContentDirectory)' != ''">
    <Error Condition="!Exists('$(_ExampleContentCatalog)')" Text="Example content catalog is missing." />
    <PropertyGroup>
      <_ExampleAssetsDestination>$(PublishDir)/Assets</_ExampleAssetsDestination>
      <_ExampleAssetsDestination Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">$(PublishDir)/wwwroot/Assets</_ExampleAssetsDestination>
      <_ExamplePublishedContentRoot>$(_ExamplePathPrefix)$([System.IO.Path]::GetFullPath('$(_ExampleAssetsDestination)/Content/', '$(MSBuildProjectDirectory)'))</_ExamplePublishedContentRoot>
    </PropertyGroup>
    <ItemGroup>
      <_ExamplePublishedContent Include="$([System.IO.Directory]::GetFiles('$(_ExampleContentPayloads)', '*.siaasset', System.IO.SearchOption.AllDirectories))" Condition="Exists('$(_ExampleContentPayloads)')" />
      <_ExamplePublishedContent Include="$([System.IO.Directory]::GetFiles('$(_ExampleContentPayloads)', '*.siascene', System.IO.SearchOption.AllDirectories))" Condition="Exists('$(_ExampleContentPayloads)')" />
      <_ExamplePublishedContent>
        <RelativeContent>$([System.IO.Path]::GetRelativePath('$(_ExampleContentPayloads)', '%(_ExamplePublishedContent.Identity)'))</RelativeContent>
      </_ExamplePublishedContent>
      <_ExamplePublishedNotices Include="$([System.IO.Directory]::GetFiles('$(_ExampleContentRoot)', '*LICENSE.txt'))" />
    </ItemGroup>
    <Copy SourceFiles="@(_ExamplePublishedContent)"
          DestinationFiles="@(_ExamplePublishedContent->'$(_ExamplePublishedContentRoot)%(RelativeContent)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(_ExampleContentCatalog)" DestinationFolder="$(_ExampleAssetsDestination)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_ExamplePublishedNotices)" DestinationFolder="$(_ExampleAssetsDestination)" SkipUnchangedFiles="true" />
  </Target>
</Project>
