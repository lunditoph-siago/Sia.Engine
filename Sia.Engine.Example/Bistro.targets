<Project>
  <PropertyGroup>
    <_ExamplePathPrefix Condition="'$(OS)' == 'Windows_NT'">\\?\</_ExamplePathPrefix>
  </PropertyGroup>
  <!-- Supply the verified example content package output. Builds can compile
       without content; publishing requires the package or a browser delegation entry. -->
  <Target Name="ValidateExampleContent" BeforeTargets="PrepareForPublish">
    <Error Condition="'$(ExampleContentDirectory)' == '' or !Exists('$(ExampleContentDirectory)/default-scenes.json')"
           Text="Publish requires ExampleContentDirectory with a packaged catalog or browser HTTPS delegation entry." />
  </Target>
  <Target Name="CopyExampleContentToOutput" AfterTargets="Build" Condition="'$(ExampleContentDirectory)' != ''">
    <Error Condition="!Exists('$(ExampleContentDirectory)/default-scenes.json')" Text="Example content catalog is missing." />
    <PropertyGroup>
      <_ExampleOutputContentRoot>$(_ExamplePathPrefix)$([System.IO.Path]::GetFullPath('$(OutDir)Assets/Content/', '$(MSBuildProjectDirectory)'))</_ExampleOutputContentRoot>
    </PropertyGroup>
    <ItemGroup>
      <_ExampleOutputContent Include="$(ExampleContentDirectory)/Content/**/*.siaasset;$(ExampleContentDirectory)/Content/**/*.siascene" />
    </ItemGroup>
    <Copy SourceFiles="@(_ExampleOutputContent->'$(_ExamplePathPrefix)%(FullPath)')"
          DestinationFiles="@(_ExampleOutputContent->'$(_ExampleOutputContentRoot)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ExampleContentDirectory)/default-scenes.json" DestinationFolder="$(OutDir)Assets" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/Assets/Bistro.LICENSE.txt" DestinationFolder="$(OutDir)Assets" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishExampleContent" AfterTargets="Publish">
    <PropertyGroup>
      <_ExampleAssetsDestination>$(PublishDir)/Assets</_ExampleAssetsDestination>
      <_ExampleAssetsDestination Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">$(PublishDir)/wwwroot/Assets</_ExampleAssetsDestination>
      <_ExamplePublishedContentRoot>$(_ExamplePathPrefix)$([System.IO.Path]::GetFullPath('$(_ExampleAssetsDestination)/Content/', '$(MSBuildProjectDirectory)'))</_ExamplePublishedContentRoot>
    </PropertyGroup>
    <ItemGroup>
      <_ExamplePublishedContent Include="$(ExampleContentDirectory)/Content/**/*.siaasset;$(ExampleContentDirectory)/Content/**/*.siascene" />
    </ItemGroup>
    <Copy SourceFiles="@(_ExamplePublishedContent->'$(_ExamplePathPrefix)%(FullPath)')"
          DestinationFiles="@(_ExamplePublishedContent->'$(_ExamplePublishedContentRoot)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ExampleContentDirectory)/default-scenes.json" DestinationFolder="$(_ExampleAssetsDestination)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/Assets/Bistro.LICENSE.txt" DestinationFolder="$(_ExampleAssetsDestination)" SkipUnchangedFiles="true" />
  </Target>
</Project>
