<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net11.0;net11.0-browser</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <PackageId>Sia.UI</PackageId>
    <SiaGraphicsRepositoryPath>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\Sia.Graphics'))</SiaGraphicsRepositoryPath>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(SiaGraphicsRepositoryPath)\Sia.Graphics\Sia.Graphics.csproj')">
    <ProjectReference Include="$(SiaGraphicsRepositoryPath)\Sia.Graphics\Sia.Graphics.csproj" />
    <ProjectReference Include="$(SiaGraphicsRepositoryPath)\Sia.RenderGraph\Sia.RenderGraph.csproj" />
    <ProjectReference Include="$(SiaGraphicsRepositoryPath)\Sia.WebGPU\Sia.WebGPU.csproj" />
  </ItemGroup>

  <ItemGroup Condition="!Exists('$(SiaGraphicsRepositoryPath)\Sia.Graphics\Sia.Graphics.csproj')">
    <PackageReference Include="Sia.Graphics" Version="0.0.17" />
    <PackageReference Include="Sia.RenderGraph" Version="0.0.17" />
    <PackageReference Include="Sia.WebGPU" Version="0.0.17" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Sia" Version="2.1.5" />
    <PackageReference Include="Sia.Input" Version="0.0.4" />
    <PackageReference Include="Sia.Prelude" Version="2.1.5" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Render/Shaders/*.wgsl" />
  </ItemGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0-browser'">
    <SupportedOSPlatformVersion>0.0</SupportedOSPlatformVersion>
  </PropertyGroup>
</Project>
