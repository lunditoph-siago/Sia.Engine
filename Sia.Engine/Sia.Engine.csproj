<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Sia.Engine</PackageId>
    <PackageDescription>Scene graph, spatial transforms, and bounds for Sia applications.</PackageDescription>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Sia.Prelude" Version="2.1.3" />
    <PackageReference Include="Sia.Math" Version="0.0.3" />
    <PackageReference Include="Sia.CodeGenerators" Version="2.1.3" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
